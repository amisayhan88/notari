# ============================================================
# notari — environment variables (testnet only, never mainnet)
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

# --- Soroban / Stellar (TESTNET ONLY) ----------------------
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_NETWORK=testnet

# Issuer/admin account: signs + sponsors transactions so teams
# don't need testnet XLM. Generate one at
# https://laboratory.stellar.org (testnet) or `stellar keys generate`.
ISSUER_SECRET_KEY=

# Contract IDs — filled in after Phase 1 testnet deploy
SUBMISSION_REGISTRY_CONTRACT_ID=
EVENT_REGISTRY_CONTRACT_ID=

# --- Postgres + pgvector ------------------------------------
# Hosted: Neon or Supabase connection string (must have the
# `vector` extension enabled), or the local docker-compose db
# (mapped to 5433 in case 5432 is taken):
# postgresql://notari:notari@localhost:5433/notari
DATABASE_URL=

# --- IPFS metadata (Pinata) ----------------------------------
# Only the CID + canonical hash go on-chain; full submission
# metadata JSON lives on IPFS.
PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_JWT=

# --- AI: embeddings + flag explanations ----------------------
# Provider-agnostic. Supported AI_PROVIDER values:
#   openai-compatible  — any OpenAI-shaped /v1 API (Qwen via
#                        ModelScope/DashScope, Ollama, OpenRouter…)
#   anthropic          — Claude Messages API (explanations only;
#                        embeddings must use openai-compatible)
AI_PROVIDER=openai-compatible

# Embeddings endpoint (OpenAI-compatible shape)
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# LLM endpoint for the "why flagged" explanation
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Anthropic-only alternative (used when AI_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Cosine-similarity threshold above which a cross-event match is
# flagged for organizer review (advisory — never auto-reject).
SIMILARITY_THRESHOLD=0.85

# --- App ------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
